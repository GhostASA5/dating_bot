      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "up{job=\"interactionservice\"}", "legendFormat": "interactionservice", "refId": "A" }],
      "title": "interactionservice",
      "type": "stat"
