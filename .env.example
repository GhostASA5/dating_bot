# Скопируйте в .env и подставьте значения.
# docker compose автоматически читает файл .env из корня проекта.

# Обязательно для Telegram-бота (получить у @BotFather)
BOT_TOKEN=

# Опционально: тот же secret_token, что при setWebhook (см. DOCKER.txt, раздел Webhook)
# BOT_WEBHOOK_SECRET=

# Локальный запуск сервисов + observability в Docker (см. observability/README.txt):
# LOKI_ENABLED=true
# SPRING_PROFILES_ACTIVE=loki
# LOKI_PUSH_URL=http://127.0.0.1:3100/loki/api/v1/push
